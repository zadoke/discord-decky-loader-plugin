{
  "name": "discord-deck",
  "version": "1.1.0-beta.1",
  "description": "Controller-first Discord for Steam Big Picture on Windows and Steam Deck Game Mode, as a Decky plugin",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zadoke/discord-decky-loader-plugin.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "discord"
  ],
  "author": "brunoccst",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zadoke/discord-decky-loader-plugin/issues"
  },
  "homepage": "https://github.com/zadoke/discord-decky-loader-plugin#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode-generator": "1.4.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
